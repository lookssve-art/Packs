# Magic Eden API Key (for higher rate limits)
PACKS_ME_API_KEY=your_api_key_here

# Polling interval in seconds (default: 45)
PACKS_POLL_INTERVAL_SECONDS=45

# Dashboard refresh interval in ms (default: 15000 = 15s)
PACKS_DASHBOARD_REFRESH_MS=15000

# Exponential decay half-life in hours (default: 24)
PACKS_DEFAULT_HALF_LIFE_HOURS=24

# Database path
PACKS_DB_PATH=data/packs.db
